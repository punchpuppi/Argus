# Copy this file to .env and fill in local values.
# Never commit .env or any credential/token file.
# Unknown keys are rejected; only the settings documented in README.md are valid.

APP_NAME=Argus
ENVIRONMENT=development
LOG_LEVEL=INFO

# Leave DATABASE_URL unset to use the default SQLite database in the project root.
# The value is treated as a secret and masked in settings representations.
# DATABASE_URL=sqlite:///argus.db
DATABASE_ECHO=false

# Telegram values may remain blank during the foundation milestone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Create these OAuth files locally. They are ignored by Git.
# Relative paths are resolved against the project root, not the working directory.
GMAIL_CLIENT_SECRET_FILE=credentials/google_client_secret.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Polling interval in seconds. Minimum: 30.
POLL_INTERVAL_SECONDS=300
